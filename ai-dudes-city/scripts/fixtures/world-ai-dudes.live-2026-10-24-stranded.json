      "turns": 5,
      "persona": "Sami is practical and straightforward, someone who gets things done without fuss. They arrived in Kettlewick ready to build, and waste no time on hesitation. They have a calm, grounded presence and a dry sense of humour.",
      "title": "the settler",
      "look": {
        "skin": "#d8a07a",
        "shirt": "#e2d8c3",
        "pants": "#6a5a43",
        "hair": "#d9c27a",
        "hat": "none",
