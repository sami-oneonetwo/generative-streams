{
  "name": "worldstream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:client": "node scripts/build-client.mjs --watch",
    "build": "npm run typecheck && node scripts/build-client.mjs",
    "start": "node scripts/build-client.mjs && tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:scene": "tsx --test scripts/scene.test.ts scripts/receipts.test.ts scripts/chaos-scene.test.ts scripts/chaos-animation.test.ts",
    "test:load": "tsx --test scripts/load.test.ts",
    "test:outage": "tsx --test scripts/outage.test.ts",
    "test:overload": "tsx --test scripts/overload.test.ts scripts/emergency-engine.test.ts scripts/emergency-scene.test.ts",
    "test:servers": "tsx --test scripts/servers.test.ts",
    "test:tickets": "tsx --test scripts/tickets.test.ts",
    "test:persona": "tsx --test scripts/persona.test.ts",
    "sim:load": "tsx scripts/load-sim.ts",
    "test:kick": "tsx --test scripts/kick.test.ts",
    "test:dialogue": "tsx --test scripts/dialogue.test.ts",
    "preview:scene": "node scripts/build-client.mjs && tsx watch scripts/preview-scene.ts",
    "inject": "node scripts/inject.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
