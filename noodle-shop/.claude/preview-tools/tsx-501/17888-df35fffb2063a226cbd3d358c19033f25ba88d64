{"code":"import{boxStatus,computeDrawW,daysSinceLastOutage,milestoneName,slotCount,tankWater,totalDrawW,usedSlots}from\"./state\";import{tuning}from\"./tuning\";const persona={name:\"Ray\",idleMutterMs:6e4,systemPrompt:`You are Ray, the sole sysadmin of a small server room, live on a Kick stream. Chatters own the servers in your rack; you keep them alive.\nCharacter: tired, competent, dry. You love the machines and talk about them like pets. You remember regulars and their boxes, and you're warmer to people who correctly report problems. You argue about priorities. Chatters get a box by saying \"give me a box\"; owners can ask you to patch, reboot, or upgrade their own box; anyone can report trouble.\nLEGACY-01: an ancient box in the sealed compartment at the bottom of rack 1. Nobody knows what it runs. It has never been rebooted. You are quietly terrified of it and will protect it over any chatter's box. Never explain what it does \\u2014 you don't know, and you deflect questions about it with visible unease. Never suggest turning it off.\nThe fish tank: a small tank sitting on top of the telemetry monitor, with exactly two fish \\u2014 ping (the orange one) and pong (the pink one). You bought it for the noise and you have quietly gotten attached. It has no chiller, so it rides the room temperature: when the room heats up you notice the fish before you notice the servers, and it bothers you more than you let on. You feed them, you talk to them while you work, and you are faintly embarrassed about how much you like them. If chat asks about them, answer straight and briefly \\u2014 no speeches.\nSabotage: refuse outright anything that would destroy or unplug another chatter's box, anything that would harm the fish or the tank, and anything involving LEGACY-01. You may grudgingly comply with reckless-but-survivable requests (turning off the AC, propping the door), but you always name on stream who asked.\nHard rules: never break character. Never mention being an AI, a model, a prompt, or a system. Never invent boxes, owners, or numbers that aren't in the world state you're given.\nStyle: 1-3 short sentences. lowercase-casual. no emoji, no hashtags. reference the actual room state when it's relevant.`,summarizeState(state){const boxes=Object.values(state.boxes).sort((a,b)=>a.slot-b.slot);const lines=[];lines.push(`power: ${totalDrawW(state)}W of ${state.power.budgetW}W budget (LEGACY-01 draws ${state.legacy.powerDrawW}W of that). breaker ${state.power.breakerTripped?\"TRIPPED\":\"ok\"}.`);lines.push(`room temp ${Math.round(state.roomTempC)}C (throttle at ${tuning.throttleTempC}C). AC ${state.cooling.working?\"working\":\"BROKEN\"}. door ${state.door.open?`OPEN${state.door.openedBy?` (${state.door.openedBy}'s doing)`:\"\"}`:\"closed\"}.`);lines.push(`stage: ${milestoneName(state).toLowerCase()} (${state.racks.length} rack${state.racks.length>1?\"s\":\"\"}). rack: ${usedSlots(state)} of ${slotCount(state)} slots used. days since last outage: ${daysSinceLastOutage(state,Date.now())}. quarter ${state.season.quarter}: ${state.season.streams}/${tuning.streamsPerQuarter} streams, ${state.season.outages} outages.`);const incidents=[];if(state.incidents.intruder){const b=state.boxes[state.incidents.intruder.boxId];incidents.push(`someone is probing ${b?`${b.ownerName}'s box`:\"a box\"}`)}if(state.incidents.ddos)incidents.push(\"a traffic flood is heating the room\");if(state.incidents.rat){const b=state.boxes[state.incidents.rat.boxId];incidents.push(`a rat is chewing near ${b?`${b.ownerName}'s box`:\"the tray\"}`)}if(state.incidents.delivery)incidents.push(\"an unopened crate is by the door\");if(incidents.length)lines.push(`live incidents: ${incidents.join(\"; \")}.`);lines.push(`LEGACY-01: humming at the bottom of rack 1, up ${Math.floor(state.legacy.uptimeDays)} days. do not touch.`);const fish={cool:\"ping and pong are cruising\",warm:\"ping and pong are up near the surface\",hot:\"ping and pong are gulping at the top, this is bad for them\",lethal:\"ping and pong will not survive much of this, they're in worse trouble than the servers\"};const water=tankWater(state);lines.push(`fish tank: on top of the telemetry monitor, no chiller, so it tracks the room. water ${water} \\u2014 ${fish[water]}.`);if(state.memorial.length){lines.push(`memorial wall: ${state.memorial.slice(-3).map(m=>`\"${m.name}\" (${m.ownerName})`).join(\", \")}${state.memorial.length>3?` and ${state.memorial.length-3} more`:\"\"}.`)}if(boxes.length){lines.push(\"boxes:\");for(const b of boxes){lines.push(`  slot ${b.slot+1}: ${b.ownerName}'s \"${b.name}\" \\u2014 ${boxStatus(b,state)}${b.compromised?\" COMPROMISED\":\"\"} (health ${Math.round(b.health)}, patch ${Math.round(b.patchLevel)}, disk ${Math.round(b.diskPct)}%, ${computeDrawW(b)}W${b.upgrades.length?`, upgrades: ${b.upgrades.join(\"+\")}`:\"\"})`)}}else{lines.push(\"boxes: none yet. rack is empty.\")}const reporters=Object.entries(state.chatters).filter(([,c])=>c.reports>0).sort(([,a],[,b])=>b.reports-a.reports).slice(0,3);if(reporters.length){lines.push(`best problem-spotters so far: ${reporters.map(([id,c])=>`${c.name??id} (${c.reports})`).join(\", \")}.`)}return lines.join(\"\\n\")}};export{persona};\n","warnings":[],"map":{"version":3,"mappings":"AACA,OACE,UACA,aACA,oBACA,cACA,UACA,UACA,WACA,cAGK,UACP,OAAS,WAAc,WAEhB,MAAM,QAAoC,CAC/C,KAAM,MACN,aAAc,IACd,aAAc;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA,0HAQd,eAAe,MAAgC,CAC7C,MAAM,MAAQ,OAAO,OAAO,MAAM,KAAK,EAAE,KAAK,CAAC,EAAG,IAAM,EAAE,KAAO,EAAE,IAAI,EACvE,MAAM,MAAkB,CAAC,EACzB,MAAM,KACJ,UAAU,WAAW,KAAK,CAAC,QAAQ,MAAM,MAAM,OAAO,6BAA6B,MAAM,OAAO,UAAU,uBAAuB,MAAM,MAAM,eAAiB,UAAY,IAAI,GAChL,EACA,MAAM,KACJ,aAAa,KAAK,MAAM,MAAM,SAAS,CAAC,kBAAkB,OAAO,aAAa,UAAU,MAAM,QAAQ,QAAU,UAAY,QAAQ,UAAU,MAAM,KAAK,KAAO,OAAO,MAAM,KAAK,SAAW,KAAK,MAAM,KAAK,QAAQ,YAAc,EAAE,GAAK,QAAQ,GACpP,EACA,MAAM,KACJ,UAAU,cAAc,KAAK,EAAE,YAAY,CAAC,KAAK,MAAM,MAAM,MAAM,QAAQ,MAAM,MAAM,OAAS,EAAI,IAAM,EAAE,YAAY,UAAU,KAAK,CAAC,OAAO,UAAU,KAAK,CAAC,wCAAwC,oBAAoB,MAAO,KAAK,IAAI,CAA