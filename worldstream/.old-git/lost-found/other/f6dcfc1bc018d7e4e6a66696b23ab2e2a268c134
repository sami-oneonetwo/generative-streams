// A quiet lo-fi loop, synthesised in the page with Web Audio so the OBS browser
// source carries it: soft chords, a walking bass, a sparse pentatonic melody,
// a brushed beat, vinyl crackle, and rain when it rains.
import type { WorldState } from '../shared/state.js';

const midiHz = (m: number) => 440 * Math.pow(2, (m - 69) / 12);

/** Four bars of chord tones (MIDI), lo-fi voicings. */
const CHORDS = [
  [50, 57, 60, 64, 65], // Dm9
  [43, 53, 59, 62, 64], // G13
  [48, 55, 59, 64, 67], // Cmaj7
  [45, 52, 55, 60, 62], // Am7(9)
];
const BASS = [38, 43, 36, 33];
const MELODY_SCALE = [62, 65, 67, 69, 72, 74, 77, 79, 81];
const TEMPO = 72;

export class Music {
  private ctx: AudioContext | null = null;
  private master!: GainNode;
  private rainGain!: GainNode;
  private nextStep = 0;
  private step = 0;
  private melody = 4;
  private enabled = true;
  private volume = 0.5;

  constructor() {
    const kick = () => void this.ensure();
    window.addEventListener('pointerdown', kick, { once: true });
    window.addEventListener('keydown', kick, { once: true });
  }

  private ensure(): boolean {
    if (!this.ctx) {
      try {
        this.ctx = new AudioContext();
      } catch {
        return false;
      }
      const ctx = this.ctx;
      this.master = ctx.createGain();
      this.master.gain.value = 0;
      const comp = ctx.createDynamicsCompressor();
      comp.threshold.value = -18;
      comp.ratio.value = 4;
      this.master.connect(comp).connect(ctx.destination);
      // vinyl crackle: quiet filtered noise with sparse clicks
      const crackle = this.noise(ctx, 4);
      const hp = ctx.createBiquadFilter();
      hp.type = 'highpass';
      hp.frequency.value = 3000;
      const cg = ctx.createGain();
      cg.gain.value = 0.015;
      crackle.connect(hp).connect(cg).connect(this.master);
      // rain bed
      const rain = this.noise(ctx, 3);
      const lp = ctx.createBiquadFilter();
      lp.type = 'lowpass';
      lp.frequency.value = 900;
      this.rainGain = ctx.createGain();
      this.rainGain.gain.value = 0;
      rain.connect(lp).connect(this.rainGain).connect(this.master);
      this.nextStep = ctx.currentTime + 0.1;
    }
    if (this.ctx.state === 'suspended') void this.ctx.resume();
    return this.ctx.state === 'running';
  }

  private noise(ctx: AudioContext, seconds: number): AudioBufferSourceNode {
    const buf = ctx.createBuffer(1, ctx.sampleRate * seconds, ctx.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
    const src = ctx.createBufferSource();
    src.buffer = buf;
    src.loop = true;
    src.start();
    return src;
  }

  update(state: WorldState | null, _now: number): void {
    if (!state) return;
    this.enabled = state.music.enabled;
    this.volume = state.music.volume;
    if (!this.enabled) {
      if (this.ctx) this.master.gain.setTargetAtTime(0, this.ctx.currentTime, 0.5);
      return;
    }
    if (!this.ensure() || !this.ctx) return;
    const ctx = this.ctx;
    this.master.gain.setTargetAtTime(this.volume * 0.8, ctx.currentTime, 0.5);
    this.rainGain.gain.setTargetAtTime(state.weather === 'rain' ? 0.32 : 0, ctx.currentTime, 1.5);
    const stepLen = 60 / TEMPO / 4;
    while (this.nextStep < ctx.currentTime + 0.4) {
      this.schedule(this.step, this.nextStep, stepLen, state);
      this.step = (this.step + 1) % 64;
      this.nextStep += stepLen * (this.step % 2 ? 1.12 : 0.88); // swing
    }
  }

  private tone(freq: number, at: number, dur: number, wave: OscillatorType, gain: number, cutoff = 2000, detune = 0): void {
    const ctx = this.ctx!;
    const o = ctx.createOscillator();
    o.type = wave;
    o.frequency.value = freq;
    o.detune.value = detune;
    const f = ctx.createBiquadFilter();
    f.type = 'lowpass';
    f.frequency.value = cutoff;
    const g = ctx.createGain();
    g.gain.setValueAtTime(0, at);
    g.gain.linearRampToValueAtTime(gain, at + Math.min(0.08, dur / 4));
    g.gain.exponentialRampToValueAtTime(0.0005, at + dur);
    o.connect(f).connect(g).connect(this.master);
    o.start(at);
    o.stop(at + dur + 0.05);
  }

  private hit(at: number, dur: number, gain: number, type: BiquadFilterType, freq: number): void {
    const ctx = this.ctx!;
    const buf = ctx.createBuffer(1, Math.ceil(ctx.sampleRate * dur), ctx.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
    const s = ctx.createBufferSource();
    s.buffer = buf;
    const f = ctx.createBiquadFilter();
    f.type = type;
    f.frequency.value = freq;
    const g = ctx.createGain();
    g.gain.value = gain;
    s.connect(f).connect(g).connect(this.master);
    s.start(at);
  }

  private kick(at: number): void {
    const ctx = this.ctx!;
    const o = ctx.createOscillator();
    o.frequency.setValueAtTime(120, at);
    o.frequency.exponentialRampToValueAtTime(45, at + 0.12);
    const g = ctx.createGain();
    g.gain.setValueAtTime(0.5, at);
    g.gain.exponentialRampToValueAtTime(0.001, at + 0.22);
    o.connect(g).connect(this.master);
    o.start(at);
    o.stop(at + 0.25);
  }

  private schedule(step: number, at: number, stepLen: number, state: WorldState): void {
    const bar = Math.floor(step / 16) % 4;
    const inBar = step % 16;
    const quiet = state.keeper.mode === 'nap';
    // pad: the chord on the first step of the bar, three soft detuned voices per note
    if (inBar === 0) {
      for (const n of CHORDS[bar]) {
        this.tone(midiHz(n), at, stepLen * 15, 'triangle', quiet ? 0.035 : 0.05, 900, -6);
        this.tone(midiHz(n), at, stepLen * 15, 'sine', 0.03, 1200, 6);
      }
    }
    // bass on 1 and the "and" of 2, plus a passing note on 4
    if (inBar === 0 || inBar === 6) this.tone(midiHz(BASS[bar]), at, stepLen * 5, 'sine', 0.22, 400);
    if (inBar === 12 && bar % 2 === 1) this.tone(midiHz(BASS[bar] + 7), at, stepLen * 3, 'sine', 0.16, 400);
    // drums, brushed
    if (!quiet) {
      if (inBar === 0 || inBar === 10) this.kick(at);
      if (inBar === 4 || inBar === 12) this.hit(at, 0.12, 0.09, 'bandpass', 1800);
      if (inBar % 4 === 2) this.hit(at, 0.04, 0.05, 'highpass', 7000);
      if (inBar === 14 && bar === 3) this.hit(at, 0.09, 0.05, 'highpass', 5000);
    }
    // a sparse pentatonic melody that wanders
    if (inBar % 2 === 0 && Math.random() < (quiet ? 0.12 : 0.28)) {
      this.melody = Math.max(0, Math.min(MELODY_SCALE.length - 1, this.melody + (Math.random() < 0.5 ? -1 : 1) * (Math.random() < 0.2 ? 2 : 1)));
      this.tone(midiHz(MELODY_SCALE[this.melody]), at, stepLen * 3.5, 'triangle', 0.09, 2600);
    }
  }
}
