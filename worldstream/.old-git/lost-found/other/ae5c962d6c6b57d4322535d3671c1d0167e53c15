// A character grid to paint pixel art into, plus the sprite writer and a PNG
// preview, shared by the rigs.
import { mkdirSync, writeFileSync } from 'node:fs';
import { dirname } from 'node:path';
import type { PixelFrame } from '../../src/shared/atlas.js';
import { encodePng } from '../png.js';
import { hexToRgb, serialiseSpriteFile } from '../sprite-io.js';

export class Grid {
  rows: string[][];
  constructor(readonly w: number, readonly h: number, fill = '.') {
    this.rows = Array.from({ length: h }, () => Array(w).fill(fill));
  }
  px(x: number, y: number, k: string): void {
    x = Math.round(x);
    y = Math.round(y);
    if (x >= 0 && x < this.w && y >= 0 && y < this.h) this.rows[y][x] = k;
  }
  get(x: number, y: number): string {
    return this.rows[y]?.[x] ?? '.';
  }
  rect(x: number, y: number, w: number, h: number, k: string): void {
    for (let j = 0; j < h; j++) for (let i = 0; i < w; i++) this.px(x + i, y + j, k);
  }
  hline(x0: number, x1: number, y: number, k: string): void {
    for (let x = Math.min(x0, x1); x <= Math.max(x0, x1); x++) this.px(x, y, k);
  }
  vline(x: number, y0: number, y1: number, k: string): void {
    for (let y = Math.min(y0, y1); y <= Math.max(y0, y1); y++) this.px(x, y, k);
  }
  line(x0: number, y0: number, x1: number, y1: number, k: string): void {
    const dx = Math.abs(x1 - x0), dy = Math.abs(y1 - y0);
    const sx = x0 < x1 ? 1 : -1, sy = y0 < y1 ? 1 : -1;
    let err = dx - dy, x = x0, y = y0;
    for (;;) {
      this.px(x, y, k);
      if (x === x1 && y === y1) break;
      const e2 = 2 * err;
      if (e2 > -dy) { err -= dy; x += sx; }
      if (e2 < dx) { err += dx; y += sy; }
    }
  }
  /** A sagging wire between two points; calls f for each pixel so bulbs can hang from it. */
  curve(x0: number, y0: number, x1: number, y1: number, sag: number, k: string, f?: (x: number, y: number, i: number) => void): void {
    const n = Math.abs(x1 - x0);
    const dir = x1 > x0 ? 1 : -1;
    for (let i = 0; i <= n; i++) {
      const t = i / Math.max(1, n);
      const x = x0 + i * dir;
      const y = Math.round(y0 + (y1 - y0) * t + sag * 4 * t * (1 - t));
      this.px(x, y, k);
      f?.(x, y, i);
    }
  }
  disc(cx: number, cy: number, r: number, k: string): void {
    for (let y = -r; y <= r; y++) for (let x = -r; x <= r; x++) if (x * x + y * y <= r * r + r * 0.5) this.px(cx + x, cy + y, k);
  }
  ring(cx: number, cy: number, r: number, k: string, thick = 1): void {
    for (let y = -r; y <= r; y++)
      for (let x = -r; x <= r; x++) {
        const d = x * x + y * y;
        if (d <= r * r + r * 0.5 && d > (r - thick) * (r - thick) + (r - thick) * 0.5) this.px(cx + x, cy + y, k);
      }
  }
  /** Copy another grid in at (x, y), skipping its transparent pixels. */
  blit(g: Grid, x: number, y: number): void {
    for (let j = 0; j < g.h; j++) for (let i = 0; i < g.w; i++) if (g.rows[j][i] !== '.') this.px(x + i, y + j, g.rows[j][i]);
  }
  /** Flip left to right. */
  flipped(): Grid {
    const g = new Grid(this.w, this.h);
    for (let y = 0; y < this.h; y++) for (let x = 0; x < this.w; x++) g.rows[y][x] = this.rows[y][this.w - 1 - x];
    return g;
  }
  frame(): PixelFrame {
    return { w: this.w, h: this.h, rows: this.rows.map((r) => r.join('')) };
  }
}

export function writeSprite(file: string, name: string, frames: Grid[], extra: Record<string, string> = {}): void {
  mkdirSync(dirname(file), { recursive: true });
  const meta: Record<string, string> = { name, anchor: 'bottom', ...extra };
  writeFileSync(file, serialiseSpriteFile(meta, frames.map((f) => f.frame())));
  console.log(`${name}: ${frames.length} frame${frames.length === 1 ? '' : 's'} ${frames[0].w}x${frames[0].h}`);
}

/** Write a grid as a PNG at an integer scale, transparent pixels in `bg`. */
export function writePreview(file: string, g: Grid, keys: Record<string, string>, scale = 3, bg = '#07163c'): void {
  mkdirSync(dirname(file), { recursive: true });
  const W = g.w * scale, H = g.h * scale;
  const rgba = new Uint8Array(W * H * 4);
  for (let y = 0; y < g.h; y++)
    for (let x = 0; x < g.w; x++) {
      const k = g.rows[y][x];
      const hex = k === '.' ? bg : keys[k];
      if (!hex) throw new Error(`no colour for key "${k}" at ${x},${y}`);
      const [r, gg, b] = hexToRgb(hex);
      for (let dy = 0; dy < scale; dy++)
        for (let dx = 0; dx < scale; dx++) {
          const i = ((y * scale + dy) * W + x * scale + dx) * 4;
          rgba[i] = r; rgba[i + 1] = gg; rgba[i + 2] = b; rgba[i + 3] = 255;
        }
    }
  writeFileSync(file, encodePng(W, H, rgba));
}
