import type { ServerMessage } from '../shared/protocol.js';
import type { WorldState } from '../shared/state.js';
import { loadDemo } from './demo.js';
import { Music } from './music.js';
import { Renderer } from './renderer.js';

const screen = document.getElementById('screen') as HTMLCanvasElement;
const params = new URLSearchParams(location.search);
const renderer = new Renderer(screen, { hud: params.has('hud') });
const demo = params.has('demo');
const music = params.has('nomusic') || demo ? null : new Music();

let state: WorldState | null = null;
let connected = false;
let clockOffset = 0; // serverNow - Date.now()

function connect(): void {
  const ws = new WebSocket(`ws://${location.host}/ws`);
  ws.onopen = () => {
    connected = true;
  };
  ws.onmessage = (ev) => {
    const m = JSON.parse(String(ev.data)) as ServerMessage;
    if (m.type === 'hello') renderer.setAtlas(m.atlas, m.shopName);
    else if (m.type === 'state') {
      state = m.state;
      clockOffset = m.now - Date.now();
    } else if (m.type === 'toast') renderer.toast(m.text, m.at);
    else if (m.type === 'presence') renderer.setPresence(m.viewers);
  };
  ws.onclose = () => {
    connected = false;
    setTimeout(connect, 1000);
  };
  ws.onerror = () => ws.close();
}

if (demo) {
  void loadDemo(params).then((d) => {
    renderer.setAtlas(d.atlas, params.get('name') ?? 'NOODLE');
    state = d.state;
    connected = true;
    setInterval(() => {
      state = d.tick(Date.now());
    }, 250);
  });
} else connect();

function frame(): void {
  const now = Date.now() + clockOffset;
  renderer.draw(state, now, connected);
  music?.update(state, now);
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);
