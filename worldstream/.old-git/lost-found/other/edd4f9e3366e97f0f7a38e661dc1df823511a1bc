// Builds the people from parts: the keeper's animation sets
// (assets/shop/keeper/*.sprite, 16x36), the passers-by and the seated customers
// (assets/shop/sprites/*.sprite), all at the same proportions with a full
// one-pixel outline in ink so they read against the lit shop. Run with
//   npx tsx scripts/rig/people.ts
import { join } from 'node:path';
import { Grid, writeSprite } from './grid.js';

const ROOT = process.cwd();
const W = 16;
const H = 36;

interface Keys {
  hair: string; skin: string; skinShade: string; eye: string;
  top: string; topLight: string; topShade: string;
  apron?: string; apronShade?: string;
  trousers: string; trouserShade: string; boot: string; bootShade: string;
  band?: string; bandKnot?: string; hat?: string; hood?: boolean; longHair?: boolean; beard?: boolean;
}

type Arm = 'down' | 'swingF' | 'swingB' | 'up' | 'raise' | 'forward' | 'hold' | 'low' | 'none';

interface Pose {
  dy?: number; lean?: number; legLen?: number; nearLeg?: number; farLeg?: number;
  nearArm?: Arm; farArm?: Arm; blink?: boolean; mouth?: 0 | 1 | 2; eyes?: number;
  headDx?: number; headDy?: number; seat?: boolean; slump?: number; kick?: boolean; ox?: number;
}

/** Add a one pixel ink outline around everything painted. */
function outline(g: Grid, k = '0'): Grid {
  const out = new Grid(g.w, g.h);
  for (let y = 0; y < g.h; y++) for (let x = 0; x < g.w; x++) out.rows[y][x] = g.rows[y][x];
  for (let y = 0; y < g.h; y++)
    for (let x = 0; x < g.w; x++) {
      if (g.rows[y][x] !== '.') continue;
      const near = [[1, 0], [-1, 0], [0, 1], [0, -1]].some(([dx, dy]) => g.get(x + dx, y + dy) !== '.' && g.get(x + dx, y + dy) !== k);
      if (near) out.rows[y][x] = k;
    }
  return out;
}

/** One pose of a standing figure whose feet are on the bottom row. */
function pose(p: Pose, K: Keys, HH = H, WW = W): Grid {
  const g = new Grid(WW, HH);
  const ox = p.ox ?? 0;
  const dy = p.dy ?? 0;
  const lean = p.lean ?? 0;
  const seat = p.seat ?? false;
  const slump = p.slump ?? 0;
  const hipY = seat ? HH - 8 : HH - 3 - (p.legLen ?? 13) + dy;
  const torsoTop = hipY - 13;
  const headTop = torsoTop - 7 + slump;
  const X = (x: number) => x + ox;

  // legs
  if (seat) {
    g.rect(X(5), hipY - 1, 9, 3, K.trousers);
    g.rect(X(11), hipY + 1, 3, 5, K.trousers);
    g.rect(X(11), hipY + 6, 4, 2, K.boot);
    g.rect(X(7), hipY + 1, 3, 5, K.trouserShade);
    g.rect(X(7), hipY + 6, 4, 2, K.bootShade);
  } else {
    const legLen = p.legLen ?? 13;
    const leg = (hipX: number, dx: number, k: string, shade: string, lift = 0) => {
      const len = legLen - lift;
      for (let r = 0; r <= len; r++) {
        const x = X(hipX) + Math.round((dx * r) / len);
        g.rect(x, hipY + r, 3, 1, k);
        g.px(x + 2, hipY + r, shade);
      }
      const bx = X(hipX) + dx;
      const ay = hipY + len;
      g.rect(bx - 1, ay, 4, 3, K.boot);
      g.rect(bx - 1, ay + 2, 4, 1, K.bootShade);
      g.px(bx + 2, ay + 1, K.bootShade);
    };
    leg(5, p.farLeg ?? 0, K.trouserShade, K.trouserShade);
    if (p.kick) {
      // near leg out in front, foot up
      for (let r = 0; r <= 9; r++) g.rect(X(8) + Math.round(r * 0.7), hipY + r, 3, 1, K.trousers);
      g.rect(X(15), hipY + 8, 3, 3, K.boot);
    } else leg(8, p.nearLeg ?? 0, K.trousers, K.trouserShade);
  }

  // torso
  const tx = X(4 + lean);
  g.rect(tx, torsoTop, 8, 13, K.top);
  g.rect(tx - 1, torsoTop + 1, 10, 3, K.top);
  g.rect(tx, torsoTop, 1, 13, K.topLight);
  g.rect(tx + 7, torsoTop + 1, 1, 12, K.topShade);
  if (K.apron) {
    g.rect(tx + 1, torsoTop + 5, 6, 8, K.apron);
    g.rect(tx + 6, torsoTop + 5, 1, 8, K.apronShade ?? K.apron);
    g.px(tx + 2, torsoTop + 4, K.apronShade ?? K.apron);
    g.px(tx + 5, torsoTop + 4, K.apronShade ?? K.apron);
    if (!seat) {
      g.rect(tx + 1, hipY, 6, 5, K.apron);
      g.rect(tx + 6, hipY, 1, 5, K.apronShade ?? K.apron);
    }
  }
  // collar
  g.rect(tx + 2, torsoTop - 1, 4, 2, K.topLight);
  g.rect(tx + 3, torsoTop, 2, 2, K.skinShade);

  // arms
  const arm = (side: 'near' | 'far', kind: Arm) => {
    const near = side === 'near';
    const ax = near ? tx + 8 : tx - 1;
    const k = near ? K.top : K.topShade;
    const hand = near ? K.skin : K.skinShade;
    const top = torsoTop + 2;
    switch (kind) {
      case 'up':
        g.rect(ax, top - 9, 2, 11, k);
        g.rect(ax, top - 11, 2, 2, hand);
        break;
      case 'raise':
        g.rect(ax, top, 2, 6, k);
        g.rect(ax + (near ? 1 : -2), top - 3, 2, 4, k);
        g.rect(ax + (near ? 1 : -2), top - 5, 2, 2, hand);
        break;
      case 'forward':
        g.rect(ax, top, 2, 6, k);
        g.rect(ax, top + 5, 6, 2, k);
        g.rect(ax + 6, top + 5, 2, 2, hand);
        break;
      case 'low': // arm forward and down, hand at hip height (stirring, wiping)
        g.rect(ax, top, 2, 5, k);
        for (let r = 0; r < 5; r++) g.rect(ax + r, top + 4 + r, 2, 1, k);
        g.rect(ax + 5, top + 9, 2, 2, hand);
        break;
      case 'hold':
        g.rect(ax, top, 2, 7, k);
        g.rect(near ? ax - 3 : ax + 2, top + 6, 4, 2, k);
        g.rect(near ? ax - 4 : ax + 5, top + 6, 2, 2, hand);
        break;
      case 'swingF':
        for (let r = 0; r < 10; r++) g.rect(ax + Math.round(r / 4), top + r, 2, 1, k);
        g.rect(ax + 3, top + 10, 2, 2, hand);
        break;
      case 'swingB':
        for (let r = 0; r < 10; r++) g.rect(ax - Math.round(r / 4), top + r, 2, 1, k);
        g.rect(ax - 3, top + 10, 2, 2, hand);
        break;
      case 'none':
        break;
      default:
        g.rect(ax, top, 2, 10, k);
        g.rect(ax, top + 10, 2, 2, hand);
    }
  };
  arm('far', p.farArm ?? 'down');
  arm('near', p.nearArm ?? 'down');

  // head
  const hx = X(5 + lean + (p.headDx ?? 0));
  const hy = headTop + (p.headDy ?? 0);
  g.rect(hx, hy + 1, 6, 5, K.skin);
  g.rect(hx + 5, hy + 1, 1, 5, K.skinShade);
  g.rect(hx + 1, hy + 5, 5, 1, K.skinShade);
  g.rect(hx, hy, 6, 1, K.hair);
  g.rect(hx - 1, hy, 1, 3, K.hair);
  g.px(hx, hy + 1, K.hair);
  g.px(hx + 6, hy + 1, K.hair);
  if (K.hood) {
    g.rect(hx - 1, hy - 1, 8, 2, K.top);
    g.rect(hx - 1, hy + 1, 1, 5, K.top);
    g.rect(hx + 6, hy + 1, 1, 5, K.topShade);
  }
  if (K.hat) {
    g.rect(hx - 1, hy - 1, 8, 2, K.hat);
    g.rect(hx - 2, hy + 1, 10, 1, K.hat);
  }
  if (K.band) {
    g.rect(hx - 1, hy + 1, 8, 1, K.band);
    g.px(hx + 6, hy + 1, K.bandKnot ?? K.band);
    g.px(hx + 7, hy + 2, K.bandKnot ?? K.band);
  }
  if (K.beard) g.rect(hx + 1, hy + 4, 4, 1, K.hair);
  if (K.longHair) {
    g.rect(hx - 1, hy + 3, 1, 4, K.hair);
    g.rect(hx + 6, hy + 2, 1, 5, K.hair);
  }
  const es = p.eyes ?? 0;
  if (!p.blink) {
    g.px(hx + 2 + es, hy + 2, K.eye);
    g.px(hx + 4 + es, hy + 2, K.eye);
  } else g.rect(hx + 2, hy + 2, 3, 1, K.skinShade);
  if (p.mouth === 1) g.rect(hx + 2, hy + 4, 2, 1, K.skinShade);
  else if (p.mouth === 2) g.px(hx + 3, hy + 4, K.skinShade);
  g.rect(hx + 2, hy + 6, 2, 1, K.skinShade);
  return g;
}

// -- the keeper -------------------------------------------------------------------

const KEEPER: Keys = {
  hair: '0', skin: 'u', skinShade: 'v', eye: '0',
  top: 'm', topLight: 'm', topShade: 'z', apron: 'o', apronShade: 'n',
  trousers: '5', trouserShade: '0', boot: 'y', bootShade: '0',
  band: 'f', bandKnot: 'g',
};
const P = (p: Pose = {}) => pose(p, KEEPER);
const fin = (g: Grid) => outline(g);

/** Held things, painted after the pose so they sit in the hand. */
function ladle(g: Grid, hx: number, hy: number, up: boolean): void {
  // hand at (hx, hy); the ladle handle rises to the left, bowl below
  if (up) {
    g.line(hx, hy, hx - 5, hy - 6, 'x');
    g.rect(hx - 7, hy - 8, 3, 2, 'w');
  } else {
    g.line(hx, hy, hx - 6, hy + 3, 'x');
    g.rect(hx - 8, hy + 3, 3, 2, 'w');
  }
}
function bowl(g: Grid, x: number, y: number): void {
  g.rect(x, y, 6, 1, 'k');
  g.rect(x - 1, y + 1, 8, 2, 'm');
  g.rect(x, y + 3, 6, 1, 'z');
  g.px(x + 6, y + 1, 'z');
  g.px(x + 6, y + 2, 'z');
  g.px(x + 2, y - 1, 'm');
  g.px(x + 4, y - 2, 'm');
}
function broom(g: Grid, hx: number, hy: number, tilt: number): void {
  g.line(hx, hy - 6, hx - 6 - tilt, hy + 11, 'v');
  g.rect(hx - 9 - tilt, hy + 11, 6, 3, 'z');
  g.rect(hx - 9 - tilt, hy + 13, 6, 1, 'v');
}
function box(g: Grid, x: number, y: number): void {
  g.rect(x, y, 9, 7, '9');
  g.rect(x, y, 9, 1, 'v');
  g.rect(x + 8, y, 1, 7, '7');
  g.rect(x + 3, y + 2, 3, 3, '7');
}
function letter(g: Grid, x: number, y: number): void {
  g.rect(x, y, 5, 3, 'z');
  g.rect(x + 1, y + 1, 3, 1, 'v');
}

const walk = (P_: (p: Pose) => Grid, arms = true): Grid[] => [
  P_({ nearLeg: 3, farLeg: -3, nearArm: arms ? 'swingB' : 'hold', farArm: arms ? 'swingF' : 'hold' }),
  P_({ dy: 1, legLen: 12, nearLeg: 2, farLeg: -1, nearArm: arms ? 'swingB' : 'hold', farArm: arms ? 'swingF' : 'hold' }),
  P_({ nearLeg: 0, farLeg: 0, nearArm: arms ? 'down' : 'hold', farArm: arms ? 'down' : 'hold' }),
  P_({ nearLeg: -3, farLeg: 3, nearArm: arms ? 'swingF' : 'hold', farArm: arms ? 'swingB' : 'hold' }),
  P_({ dy: 1, legLen: 12, nearLeg: -1, farLeg: 2, nearArm: arms ? 'swingF' : 'hold', farArm: arms ? 'swingB' : 'hold' }),
  P_({ nearLeg: 0, farLeg: 0, nearArm: arms ? 'down' : 'hold', farArm: arms ? 'down' : 'hold' }),
];

const KD = join(ROOT, 'assets/shop/keeper');
const w = (name: string, frames: Grid[], fps: number, extra: Record<string, string> = {}) => writeSprite(join(KD, `${name}.sprite`), `keeper_${name}`, frames.map(fin), { fps: String(fps), ...extra });

w('idle', [P(), P(), P({ headDy: 1 }), P(), P({ blink: true }), P()], 2);
w('walk', walk(P), 8);
w('talk', [P({ mouth: 0 }), P({ mouth: 1, nearArm: 'raise' }), P({ mouth: 2, nearArm: 'raise' })], 4);
w('look', [P({ eyes: 1 }), P({ eyes: 1, headDx: 1 }), P({ eyes: -1 }), P()], 1, { loop: 'no' });
{
  // cooking: facing the pot on his left, so the far arm does the stirring
  const c = (up: boolean, lean: number) => {
    const g = P({ lean, nearArm: 'hold', farArm: up ? 'raise' : 'low', headDy: up ? 0 : 1 });
    ladle(g, up ? 3 + lean - 2 : 3 + lean + 4, up ? 12 : 21, up);
    return g;
  };
  w('cook', [c(false, 1), c(false, 2), c(true, 1), c(true, 0)], 5);
}
{
  const s = (dy: number) => {
    const g = P({ nearArm: 'forward', farArm: 'forward', headDy: dy });
    bowl(g, 12, 15 + dy);
    return g;
  };
  w('serve', [s(0), s(1), s(0)], 3);
}
{
  const step = (p: Pose) => {
    const g = P({ ...p, nearArm: 'forward', farArm: 'forward' });
    bowl(g, 12 + (p.lean ?? 0), 15 + (p.dy ?? 0));
    return g;
  };
  w('walk_bowl', [step({ nearLeg: 3, farLeg: -3 }), step({ dy: 1, legLen: 12, nearLeg: 2, farLeg: -1 }), step({}), step({ nearLeg: -3, farLeg: 3 }), step({ dy: 1, legLen: 12, nearLeg: -1, farLeg: 2 }), step({})], 8);
}
w('wave', [P({ farArm: 'up', mouth: 1 }), P({ farArm: 'raise', mouth: 1, headDx: 1 }), P({ farArm: 'up', mouth: 2 })], 4);
w('fix', [P({ lean: 1, nearArm: 'low', farArm: 'low', headDy: 1 }), P({ lean: 2, nearArm: 'forward', farArm: 'low', headDy: 2 }), P({ lean: 1, nearArm: 'low', farArm: 'raise', headDy: 1 }), P({ lean: 2, nearArm: 'forward', farArm: 'low', headDy: 2 })], 6);
w('kick', [P({ nearArm: 'hold', farArm: 'hold' }), P({ kick: true, lean: -1, nearArm: 'swingB', farArm: 'swingF' }), P({ kick: true, lean: -1, nearArm: 'swingB', farArm: 'swingF' }), P({ nearArm: 'hold', farArm: 'hold', headDy: 1 })], 5, { loop: 'no' });
{
  const s = (tilt: number, lean: number) => {
    const g = P({ lean, nearArm: 'hold', farArm: 'low', headDy: 1 });
    broom(g, 10 + lean, 16, tilt);
    return g;
  };
  w('sweep', [s(0, 0), s(2, 1), s(4, 2), s(2, 1)], 5);
}
{
  const c = (p: Pose) => {
    const g = P({ ...p, nearArm: 'hold', farArm: 'hold' });
    box(g, 5 + (p.lean ?? 0), 14 + (p.dy ?? 0));
    return g;
  };
  w('carry', walk(c, false), 8);
}
{
  const m = (p: Pose) => {
    const g = P({ ...p, nearArm: 'hold', farArm: 'down', eyes: 0, headDy: 1 });
    letter(g, 8, 17);
    return g;
  };
  w('read', [m({}), m({ headDy: 2 }), m({ blink: true })], 2);
}
w('sit', [P({ seat: true, nearArm: 'forward' }), P({ seat: true, nearArm: 'forward', headDy: 1, blink: true })], 1);
w('nap', [P({ seat: true, slump: 3, headDy: 2, blink: true, nearArm: 'down', farArm: 'down' }), P({ seat: true, slump: 4, headDy: 2, blink: true, nearArm: 'down', farArm: 'down' })], 1);
w('wipe', [P({ lean: 1, nearArm: 'low', headDy: 1 }), P({ lean: 2, nearArm: 'low', headDy: 1 }), P({ lean: 1, nearArm: 'forward', headDy: 1 }), P({ lean: 0, nearArm: 'low' })], 5);

// -- passers-by (world keys only), walking cycles ------------------------------------

const SP = join(ROOT, 'assets/shop/sprites');
const ws = (name: string, frames: Grid[], fps: number, extra: Record<string, string> = {}) => writeSprite(join(SP, `${name}.sprite`), name, frames.map(fin), { fps: String(fps), ...extra });

const COAT: Keys = { hair: '5', skin: 'u', skinShade: 'v', eye: '0', top: '8', topLight: 'w', topShade: '5', trousers: '6', trouserShade: '5', boot: '0', bootShade: '0', hat: '5' };
ws('walker_coat', walk((p) => pose(p, COAT)), 6);

const HOOD: Keys = { hair: '0', skin: 'z', skinShade: 'v', eye: '0', top: 'o', topLight: 'p', topShade: 'n', trousers: '0', trouserShade: '0', boot: 'y', bootShade: '0', hood: true };
ws('walker_hood', walk((p) => pose(p, HOOD)), 6);

const UMB: Keys = { hair: '9', skin: 'u', skinShade: 'v', eye: '0', top: 'e', topLight: 'f', topShade: 'd', trousers: '5', trouserShade: '0', boot: '0', bootShade: '0', longHair: true };
const umbrella = (p: Pose) => {
  const g = pose({ ...p, nearArm: 'hold' }, UMB);
  const shaftX = 9 + (p.lean ?? 0);
  g.vline(shaftX, 2, 14, 'v');
  for (let r = 0; r < 3; r++) g.rect(shaftX - 6 + r * 2, 2 - r, 13 - r * 4, 1, r === 2 ? 'g' : 'f');
  g.hline(shaftX - 6, shaftX + 6, 3, 'd');
  return g;
};
ws('walker_umbrella', walk(umbrella), 6);

const KID: Keys = { hair: '9', skin: 'u', skinShade: 'v', eye: '0', top: 'k', topLight: 'l', topShade: 'j', trousers: 'o', trouserShade: 'n', boot: 'y', bootShade: '0' };
ws('walker_kid', walk((p) => pose({ ...p, legLen: Math.min(8, p.legLen ?? 8) }, KID, 28)), 7);

const OLD: Keys = { hair: 'x', skin: 'u', skinShade: 'v', eye: '0', top: '9', topLight: 'v', topShade: '7', trousers: 'y', trouserShade: '0', boot: '0', bootShade: '0', beard: true };
ws('walker_old', walk((p) => pose({ ...p, nearArm: 'hold', legLen: 12 }, OLD)).map((g) => { g.vline(13, 15, 33, 'v'); return g; }), 4);

// -- customers seen from behind, sitting at the counter --------------------------------

function seated(hair: string, top: string, topShade: string, bob: number, chop: boolean): Grid {
  const g = new Grid(14, 30);
  // legs down to the footrest
  g.rect(3, 20, 3, 9, '5');
  g.rect(8, 20, 3, 9, '5');
  g.rect(2, 28, 4, 2, '0');
  g.rect(8, 28, 4, 2, '0');
  // seat of the stool shows between the legs? no: torso covers it
  g.rect(2, 9 + bob, 10, 12, top);
  g.rect(11, 9 + bob, 1, 12, topShade);
  g.rect(1, 10 + bob, 1, 6, top);
  g.rect(12, 10 + bob, 1, 6, topShade);
  // arms reaching forward to the counter
  g.rect(0, 12 + bob, 2, 6, top);
  g.rect(12, 12 + bob, 2, 6, topShade);
  g.rect(0, 17 + bob, 2, 2, 'u');
  g.rect(12, 17 + bob, 2, 2, 'v');
  if (chop) {
    g.line(13, 16 + bob, 13, 11 + bob, 'z');
  }
  // head from behind: hair
  g.rect(3, 1 + bob, 8, 8, hair);
  g.rect(4, 0 + bob, 6, 1, hair);
  g.rect(4, 8 + bob, 6, 1, 'v'); // the neck
  g.rect(5, 9 + bob, 4, 1, 'u');
  return g;
}
ws('customer_a', [seated('0', 'e', 'd', 0, false), seated('0', 'e', 'd', 1, true)], 2);
ws('customer_b', [seated('9', 'o', 'n', 0, false), seated('9', 'o', 'n', 1, true)], 2);
ws('customer_c', [seated('5', 'a', '9', 0, false), seated('5', 'a', '9', 1, true)], 2);
ws('customer_d', [seated('x', 'w', 'y', 0, false), seated('x', 'w', 'y', 1, true)], 2);
