/** Things around the shop that have a state the keeper can change. */
export const FIXTURE_IDS = ['bin', 'board', 'vending', 'mailbox', 'plant', 'door', 'lantern', 'sign'] as const;
export type FixtureId = (typeof FIXTURE_IDS)[number];

export interface FixtureDef {
  /** Left edge and the row its bottom sits on. */
  x: number;
  y: number;
  states: readonly string[];
  initial: string;
  /** Drawn from a sprite named `<id>_<state>`; otherwise the renderer draws the state as an overlay on the building. */
  sprite: boolean;
  /** How the keeper talks about it. */
  label: string;
  /** Words chat uses for it. */
  aliases: string[];
}

