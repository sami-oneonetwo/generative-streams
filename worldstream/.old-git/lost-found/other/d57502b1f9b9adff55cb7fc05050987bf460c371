export function stoolCentre(i: number): number {
  return STOOLS[i] + STOOL_W / 2;
}

/** Baseline y for a zone. */
export function zoneGround(zone: Zone): number {
  return zone === 'upstairs' ? BALCONY_Y : GROUND;
}
