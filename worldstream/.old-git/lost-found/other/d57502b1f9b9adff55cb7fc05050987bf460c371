/** Layers the keeper can be in. Inside is behind the counter; upstairs is the balcony. */
export type Zone = 'inside' | 'outside' | 'upstairs' | 'hidden';

export type Facing = 'l' | 'r';

export interface Spot {
  /** Left edge of the keeper (16 wide). */
  x: number;
  zone: Zone;
  facing: Facing;
}

export const SPOT_IDS = [
