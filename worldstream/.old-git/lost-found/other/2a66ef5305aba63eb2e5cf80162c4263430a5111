// World state: the single source of truth, owned by the server, broadcast
// whole to renderers. Plain data; every change goes through the pure reducer.
import type { Facing, FixtureId, Zone } from './scene.js';
import { FIXTURES, FIXTURE_IDS, SPOTS } from './scene.js';

export const WEATHERS = ['clear', 'rain', 'snow', 'fog'] as const;
export type Weather = (typeof WEATHERS)[number];

export const KEEPER_MODES = ['idle', 'walk', 'walk_bowl', 'talk', 'look', 'cook', 'serve', 'wave', 'fix', 'kick', 'sweep', 'carry', 'read', 'sit', 'nap', 'wipe'] as const;
export type KeeperMode = (typeof KEEPER_MODES)[number];

/** Never expires. JSON-safe, unlike Infinity. */
export const FOREVER = 9007199254740991;

export interface Motion {
  fromX: number;
  toX: number;
  startAt: number;
  endAt: number;
}

export interface Bubble {
  text: string;
  until: number;
}

export interface KeeperState {
  /** Left edge, screen pixels. */
  x: number;
  zone: Zone;
  facing: Facing;
  mode: KeeperMode;
  /** When the mode last changed, so one-shot animations start from frame 0. */
  modeSince: number;
  motion?: Motion;
  bubble?: Bubble;
  /** In his hands while he walks: a box uses the carry cycle, a bowl the serving walk. */
  carrying?: 'box' | 'bowl';
  /** What he is up to, for the hud and the admin page. */
  job?: { id: string; label: string };
}

export type EntityKind = 'flag' | 'cat' | 'bowl' | 'customer' | 'passerby';

export interface Entity {
  id: string;
  kind: EntityKind;
  /** Sprite name; the renderer flips it to face `facing`. */
  sprite: string;
  /** Left edge and the row the bottom sits on. */
  x: number;
  y: number;
  facing: Facing;
  motion?: Motion;
  /** 'world' for things the shop made, else the viewer's id. */
  addedBy: string;
  addedByName?: string;
  addedAt: number;
  expiresAt: number;
  /** Flags: the words, and the cloth's palette key. */
  text?: string;
  colour?: string;
  /** Customers and bowls: which stool. */
  stool?: number;
  say?: Bubble;
  /** Behaviour state for the cat: what it is doing and until when. */
  doing?: { what: 'walk' | 'sit' | 'sleep'; until: number; at?: string };
}

export type OrderPhase = 'waiting' | 'seated' | 'cooking' | 'eating' | 'leaving';

export interface Order {
  id: string;
  user: { id: string; name: string };
  dish: string;
  at: number;
  phase: OrderPhase;
  stool?: number;
  customerId?: string;
  bowlId?: string;
  /** When the bowl is empty and the customer gets up. */
  eatUntil?: number;
}

export interface FixtureState {
  state: string;
  since: number;
  /** He has clocked it and will get to it. */
  noticed?: boolean;
}

export interface WorldState {
  version: 2;
  weather: Weather;
  weatherUntil: number;
  keeper: KeeperState;
  fixtures: Record<FixtureId, FixtureState>;
  entities: Entity[];
  orders: Order[];
  /** Bowls served, all time. */
  served: number;
  music: { enabled: boolean; volume: number };
  /** Last time anyone said anything. */
  lastChatAt: number;
}

export function initialFixtures(now: number): Record<FixtureId, FixtureState> {
  const out = {} as Record<FixtureId, FixtureState>;
  for (const id of FIXTURE_IDS) out[id] = { state: FIXTURES[id].initial, since: now };
  return out;
}

export function initialState(now = Date.now()): WorldState {
  return {
    version: 2,
    weather: 'clear',
    weatherUntil: now + 10 * 60_000,
    keeper: { x: SPOTS.kitchen.x, zone: 'inside', facing: 'l', mode: 'cook', modeSince: now },
    fixtures: initialFixtures(now),
    entities: [],
    orders: [],
    served: 0,
    music: { enabled: true, volume: 0.5 },
    lastChatAt: now,
  };
}

export type Mutation =
  | { type: 'set_weather'; weather: Weather; until: number }
  | { type: 'keeper'; patch: Partial<KeeperState> }
  | { type: 'fixture'; id: FixtureId; state: string; at: number }
  | { type: 'fixture_noticed'; id: FixtureId }
  | { type: 'add_entity'; entity: Entity }
  | { type: 'entity'; id: string; patch: Partial<Entity> }
  | { type: 'remove_entity'; id: string }
  | { type: 'add_order'; order: Order }
  | { type: 'order'; id: string; patch: Partial<Order> }
  | { type: 'remove_order'; id: string }
  | { type: 'served' }
  | { type: 'music'; enabled?: boolean; volume?: number }
  | { type: 'chat_seen'; at: number }
  | { type: 'expire'; now: number }
  | { type: 'clear_entities'; kind?: EntityKind };

/** Merge a patch; keys set to undefined are removed. */
function patch<T extends object>(target: T, p: Partial<T>): T {
  const out = { ...target } as Record<string, unknown>;
  for (const [k, v] of Object.entries(p)) {
    if (v === undefined) delete out[k];
    else out[k] = v;
  }
  return out as T;
}

export function apply(state: WorldState, m: Mutation): WorldState {
  switch (m.type) {
    case 'set_weather':
      return { ...state, weather: m.weather, weatherUntil: m.until };
    case 'keeper':
      return { ...state, keeper: patch(state.keeper, m.patch) };
    case 'fixture': {
      if (!FIXTURES[m.id].states.includes(m.state)) return state;
      if (state.fixtures[m.id].state === m.state) return state;
      return { ...state, fixtures: { ...state.fixtures, [m.id]: { state: m.state, since: m.at } } };
    }
    case 'fixture_noticed':
      return { ...state, fixtures: { ...state.fixtures, [m.id]: { ...state.fixtures[m.id], noticed: true } } };
    case 'add_entity':
      if (state.entities.some((e) => e.id === m.entity.id)) return state;
      return { ...state, entities: [...state.entities, m.entity] };
    case 'entity':
      return { ...state, entities: state.entities.map((e) => (e.id === m.id ? patch(e, m.patch) : e)) };
    case 'remove_entity':
      return { ...state, entities: state.entities.filter((e) => e.id !== m.id) };
    case 'add_order':
      if (state.orders.some((o) => o.id === m.order.id)) return state;
      return { ...state, orders: [...state.orders, m.order] };
    case 'order':
      return { ...state, orders: state.orders.map((o) => (o.id === m.id ? patch(o, m.patch) : o)) };
    case 'remove_order':
      return { ...state, orders: state.orders.filter((o) => o.id !== m.id) };
    case 'served':
      return { ...state, served: state.served + 1 };
    case 'music':
      return { ...state, music: { enabled: m.enabled ?? state.music.enabled, volume: m.volume ?? state.music.volume } };
    case 'chat_seen':
      return { ...state, lastChatAt: m.at };
    case 'expire': {
      const keep = state.entities.filter((e) => e.expiresAt > m.now);
      const keeper = state.keeper.bubble && state.keeper.bubble.until <= m.now ? patch(state.keeper, { bubble: undefined }) : state.keeper;
      const said = keep.map((e) => (e.say && e.say.until <= m.now ? patch(e, { say: undefined }) : e));
      if (keep.length === state.entities.length && keeper === state.keeper && said.every((e, i) => e === keep[i])) return state;
      return { ...state, entities: said, keeper };
    }
    case 'clear_entities':
      return { ...state, entities: m.kind ? state.entities.filter((e) => e.kind !== m.kind) : [] };
    default:
      return state;
  }
}

/** Where a moving thing is now. */
export function motionX(x: number, motion: Motion | undefined, now: number): number {
  if (!motion) return x;
  if (now >= motion.endAt) return motion.toX;
  if (now <= motion.startAt) return motion.fromX;
  const t = (now - motion.startAt) / (motion.endAt - motion.startAt);
  return motion.fromX + (motion.toX - motion.fromX) * t;
}

/** Bring a state read from disk up to date and drop anything transient. */
export function reviveState(raw: unknown, now: number): WorldState {
  const base = initialState(now);
  if (!raw || typeof raw !== 'object') return base;
  const s = raw as Partial<WorldState>;
  if (s.version !== 2) return base;
  const fixtures = { ...base.fixtures, ...(s.fixtures ?? {}) };
  for (const id of FIXTURE_IDS) if (!FIXTURES[id].states.includes(fixtures[id]?.state)) fixtures[id] = base.fixtures[id];
  fixtures.door = { state: 'closed', since: now };
  const entities = (s.entities ?? []).filter((e) => e.kind === 'flag' || e.kind === 'cat').map((e) => ({ ...e, motion: undefined, say: undefined }));
  return {
    ...base,
    weather: WEATHERS.includes(s.weather as Weather) ? (s.weather as Weather) : 'clear',
    weatherUntil: s.weatherUntil ?? base.weatherUntil,
    fixtures,
    entities,
    served: s.served ?? 0,
    music: s.music ?? base.music,
  };
}
