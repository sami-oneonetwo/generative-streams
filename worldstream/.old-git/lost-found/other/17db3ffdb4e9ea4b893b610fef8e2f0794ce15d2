// Composes the scene from the sprite files as the renderer would, so the art
// can be checked without a browser: dist/shop/preview.png (the shop at rest
// with the keeper cooking, a customer, the cat and a passer-by) and
// dist/shop/keeper-sheet.png (every keeper frame). Run after the rigs:
//   npx tsx scripts/rig/preview.ts
import { readdirSync, readFileSync } from 'node:fs';
import { basename, join } from 'node:path';
import { parsePalette, parseSpriteFile } from '../sprite-io.js';
import type { PixelFrame } from '../../src/shared/atlas.js';
import { COUNTER, FIXTURES, GROUND, PASSER_Y, SPOTS, STOOLS, VIEW } from '../../src/shared/scene.js';
import { Grid, writePreview } from './grid.js';

const ROOT = process.cwd();
const keys = parsePalette(readFileSync(join(ROOT, 'assets/shop/palette.txt'), 'utf8'));

function load(dir: string): Map<string, PixelFrame[]> {
  const out = new Map<string, PixelFrame[]>();
  for (const f of readdirSync(dir).filter((f) => f.endsWith('.sprite'))) {
    const sf = parseSpriteFile(readFileSync(join(dir, f), 'utf8'), f);
    out.set(sf.meta.name ?? basename(f, '.sprite'), sf.frames);
  }
  return out;
}
const sprites = load(join(ROOT, 'assets/shop/sprites'));
const keeper = load(join(ROOT, 'assets/shop/keeper'));

function toGrid(f: PixelFrame): Grid {
  const g = new Grid(f.w, f.h);
  f.rows.forEach((r, y) => { for (let x = 0; x < r.length; x++) g.rows[y][x] = r[x]; });
  return g;
}
/** Draw a frame with its bottom row on `bottom`. */
function stand(scene: Grid, name: string, x: number, bottom: number, frame = 0, flip = false, from = sprites): void {
  const frames = from.get(name);
  if (!frames) throw new Error(`no sprite ${name}`);
  let g = toGrid(frames[frame % frames.length]);
  if (flip) g = g.flipped();
  scene.blit(g, x, bottom - g.h);
}

const scene = new Grid(VIEW.w, VIEW.h, '1');
for (let y = 120; y < 240; y++) if ((y & 1) === 0 || y > 180) scene.hline(0, VIEW.w - 1, y, '2');
for (let x = 0; x < VIEW.w; x++) {
  const m = 200 - Math.round(18 * Math.abs(Math.sin(x / 70)) + 14 * Math.abs(Math.sin(x / 31 + 2)));
  scene.vline(x, m, 240, '3');
}
scene.rect(0, 240, VIEW.w, 30, '0');
scene.blit(toGrid(sprites.get('shop_back')![0]), 0, 0);
// keeper cooking, behind the counter
stand(scene, 'keeper_cook', SPOTS.kitchen.x, GROUND, 0, SPOTS.kitchen.facing === 'l', keeper);
scene.blit(toGrid(sprites.get('shop_front')![0]), 0, 0);
// fixtures at rest
for (const [id, def] of Object.entries(FIXTURES)) if (def.sprite) stand(scene, `${id}_${def.initial}`, def.x, def.y);
// a customer on the second stool with a bowl in front of them
stand(scene, 'customer_a', STOOLS[1] - 3, COUNTER.bottom + 8);
stand(scene, 'bowl', STOOLS[1] - 1, COUNTER.top + 1);
stand(scene, 'customer_c', STOOLS[3] - 3, COUNTER.bottom + 8, 1);
// the cat on top of the vending machine, a passer-by on the pavement
stand(scene, 'cat_sit', FIXTURES.vending.x + 2, GROUND - 32);
stand(scene, 'walker_coat', 400, PASSER_Y, 0, true);
stand(scene, 'walker_kid', 30, PASSER_Y, 2);
writePreview(join(ROOT, 'dist/shop/preview.png'), scene, keys, 3);

// keeper contact sheet: one row per mode
const modes = [...keeper.keys()].sort();
const cols = Math.max(...[...keeper.values()].map((f) => f.length));
const sheet = new Grid(4 + cols * 20, 4 + modes.length * 40, '2');
modes.forEach((m, row) => {
  keeper.get(m)!.forEach((f, i) => sheet.blit(toGrid(f), 4 + i * 20, 4 + row * 40));
});
writePreview(join(ROOT, 'dist/shop/keeper-sheet.png'), sheet, keys, 4, '#0a2a48');
// props sheet
const names = [...sprites.keys()].filter((n) => !n.startsWith('shop_')).sort();
let px = 4, py = 4, rowH = 0;
const cells: Array<[Grid, number, number]> = [];
for (const n of names) {
  const fr = sprites.get(n)!;
  const w = fr.reduce((a, f) => a + f.w + 2, 0);
  if (px + w > 300) { px = 4; py += rowH + 6; rowH = 0; }
  for (const f of fr) { cells.push([toGrid(f), px, py]); px += f.w + 2; rowH = Math.max(rowH, f.h); }
  px += 6;
}
const props = new Grid(300, py + rowH + 4, '2');
for (const [g, x, y] of cells) props.blit(g, x, y);
writePreview(join(ROOT, 'dist/shop/props-sheet.png'), props, keys, 4, '#0a2a48');
console.log(`preview: ${modes.length} keeper modes, ${names.length} sprites -> dist/shop/{preview,keeper-sheet,props-sheet}.png`);
