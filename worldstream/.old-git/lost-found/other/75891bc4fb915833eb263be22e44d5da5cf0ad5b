// -- painters -----------------------------------------------------------------

/** A tiled pagoda roof: ridge at (x..x+w, y), the eave `h` rows down and `flare` wider each side, its ends curling up. */
function roof(g: Grid, x: number, y: number, w: number, h: number, flare: number): void {
  for (let r = 0; r < h; r++) {
    const grow = Math.round((flare * r) / (h - 1));
    const x0 = x - grow, x1 = x + w - 1 + grow;
    const k = r % 3 === 2 ? '5' : 'b';
    g.hline(x0, x1, y + r, k);
    if (k === 'b') for (let px = x0 + ((r * 2) % 4); px <= x1; px += 4) g.px(px, y + r, 'c');
  }
  // ridge beam and the curled ends
  g.hline(x, x + w - 1, y, '8');
  g.hline(x + 1, x + w - 2, y - 1, '8');
  for (let i = 0; i < 3; i++) {
    g.px(x - flare - i, y + h - 1 - i, '8');
    g.px(x + w - 1 + flare + i, y + h - 1 - i, '8');
    g.px(x - flare - i + 1, y + h - 1 - i, 'c');
    g.px(x + w - 2 + flare + i, y + h - 1 - i, 'c');
  }
  // shadow under the eave
  g.hline(x - flare, x + w - 1 + flare, y + h, '5');
}

/** Dark planked wall with a beam along the top and posts at the ends. */
function wall(g: Grid, x: number, y: number, w: number, h: number, seam = 6): void {
  g.rect(x, y, w, h, '6');
  for (let px = x + seam; px < x + w - 1; px += seam) g.vline(px, y, y + h - 1, '5');
  g.hline(x, x + w - 1, y, '8');
  g.rect(x, y, 2, h, '9');
  g.rect(x + w - 2, y, 2, h, '9');
  g.vline(x + w - 1, y, y + h - 1, '5');
}

/** A shoji lattice window: `bg` panes behind `bar` bars, in a warm frame. */
function lattice(g: Grid, x: number, y: number, w: number, h: number, bg: string, bar: string, sx = 4, sy = 5): void {
  g.rect(x, y, w, h, bg);
  for (let px = x + sx; px < x + w - 1; px += sx) g.vline(px, y, y + h - 1, bar);
  for (let py = y + sy; py < y + h - 1; py += sy) g.hline(x, x + w - 1, py, bar);
  g.rect(x, y, w, 1, '9');
  g.rect(x, y + h - 1, w, 1, '9');
  g.rect(x, y, 1, h, '9');
  g.rect(x + w - 1, y, 1, h, '5');
}

/** A red paper lantern, 8 wide 12 tall, hanging from (x, y). */
function lantern(g: Grid, x: number, y: number): void {
  g.rect(x + 3, y, 2, 1, '9');
  g.rect(x + 2, y + 1, 4, 1, 'e');
  g.rect(x + 1, y + 2, 6, 7, 'f');
  g.rect(x, y + 3, 8, 5, 'f');
  g.rect(x + 2, y + 3, 3, 5, 'g');
  g.rect(x + 3, y + 4, 1, 3, 'h');
  g.vline(x + 6, y + 3, y + 7, 'e');
  g.hline(x + 1, x + 6, y + 5, 'e');
  g.rect(x + 2, y + 9, 4, 1, 'e');
  g.rect(x + 3, y + 10, 2, 2, '9');
}

/** A bowl of noodles: rim at (cx, top), `w` wide, steam above, chopsticks leaning in. */
function bowlGlyph(g: Grid, cx: number, top: number, w: number, k: string, steam: string): void {
  const half = Math.floor(w / 2);
  g.hline(cx - half, cx + half, top, k);
  g.hline(cx - half, cx + half, top + 1, k);
  const depth = Math.max(4, Math.round(w / 2.4));
  for (let r = 2; r <= depth; r++) {
    const shrink = Math.round(((half - Math.round(w / 4)) * (r - 1)) / depth);
    g.px(cx - half + shrink, top + r, k);
    g.px(cx + half - shrink, top + r, k);
  }
  const foot = Math.round(w / 4);
  g.hline(cx - foot, cx + foot, top + depth + 1, k);
  g.hline(cx - foot + 1, cx + foot - 1, top + depth + 2, k);
  // chopsticks
  g.line(cx + 2, top - Math.round(w / 2), cx + Math.round(w / 3), top - 1, k);
  g.line(cx + 4, top - Math.round(w / 2) + 1, cx + Math.round(w / 3) + 2, top - 1, k);
  // steam
  for (const dx of [-Math.round(w / 4), 0, Math.round(w / 4) - 1]) {
    for (let r = 0; r < Math.round(w / 3); r++) g.px(cx + dx + ((r >> 1) & 1), top - 3 - r, steam);
  }
}

/** The tower sign: a white bowl with yellow noodles lifted on chopsticks, steam above. */
function noodleGlyph(g: Grid, cx: number, cy: number): void {
  g.hline(cx - 7, cx + 7, cy + 3, 'm');
  g.hline(cx - 6, cx + 6, cy + 4, 'm');
  g.px(cx - 6, cy + 5, 'm');
  g.px(cx + 6, cy + 5, 'm');
  g.hline(cx - 5, cx + 5, cy + 6, 'm');
  g.hline(cx - 4, cx + 4, cy + 7, 'm');
  g.hline(cx - 3, cx + 3, cy + 8, 'm');
  g.hline(cx - 2, cx + 2, cy + 9, 'm');
  for (let i = 0; i < 4; i++) {
    const x = cx - 5 + i * 3;
    g.vline(x, cy - 4 + (i & 1), cy + 2, 'l');
    g.px(x + 1, cy - 3 + (i & 1), 'l');
    g.px(x + 1, cy, 'l');
  }
  g.line(cx + 3, cy - 10, cx + 7, cy - 4, 'z');
  g.line(cx + 5, cy - 10, cx + 8, cy - 5, 'z');
  for (const dx of [-4, 0, 4]) for (let r = 0; r < 4; r++) g.px(cx + dx + (r & 1), cy - 6 - r, 'm');
}

