const preview = new Grid(VIEW.w, VIEW.h, '1');
preview.rect(0, 0, VIEW.w, 240, '1');
for (let y = 120; y < 240; y++) if ((y & 1) === 0 || y > 180) preview.hline(0, VIEW.w - 1, y, '2');
for (let x = 0; x < VIEW.w; x++) {
  const m = 200 - Math.round(18 * Math.abs(Math.sin(x / 70)) + 14 * Math.abs(Math.sin(x / 31 + 2)));
  preview.vline(x, m, 240, '3');
}
preview.rect(0, 240, VIEW.w, 30, '0');
preview.blit(back, 0, 0);
preview.blit(front, 0, 0);
writePreview(join(ROOT, 'dist/shop/preview.png'), preview, keys, 3);
