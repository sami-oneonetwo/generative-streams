// Paints the noodle shop: the building and its street, as two full-width
// sprites. `shop_back` is everything behind the keeper when he is behind the
// counter or on the balcony; `shop_front` is the little that stands in front
// of him there (the counter, the stools, the awning posts, the balcony rail).
// Run with `npx tsx scripts/rig/shop.ts`, then `npm run assets`, and look at
// dist/shop/preview.png.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { parsePalette } from '../sprite-io.js';
