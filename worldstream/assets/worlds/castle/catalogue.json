  "lines": {
    "ambient": [
      "stone remembers everything. that is its problem.",
      "somewhere in here there is a room nobody has opened in a century",
      "the torches never go out. nobody lights them. do not think about it.",
      "fog again. the castle prefers it.",
      "the king is either asleep or a rumour",
      "every stair in this place is a trap for the knees",
      "I could live here. cold, but nobody asks questions."
    ],
    "weather": {
      "fog": [
        "the fog is back. it lives here.",
        "cannot see the far towers"
      ],
      "rain": [
        "rain on stone. the oldest sound.",
        "the gutters are gargoyles. they are not enjoying this."
      ],
      "clear": [
        "clear. the castle looks embarrassed.",
        "you can see the whole valley from the wall"
      ],
      "storm": [
        "lightning on the east tower. again.",
        "the dragon hates this"
      ]
    },
    "added": [
      "{user} brought a {thing} into the keep",
      "a {thing}. {user}'s doing. the guards did not notice.",
      "{user} thinks the castle needed a {thing}",
      "okay. a {thing}. thanks {user}"
    ],
    "addedText": [
      "{user} had \"{text}\" carved into the stone",
      "a plaque now reads \"{text}\". {user}.",
      "\"{text}\", says {user}. very medieval."
    ],
    "removed": [
      "the {thing} is gone. the castle took it.",
      "{thing}, gone",
      "no more {thing}"
    ]
  },
