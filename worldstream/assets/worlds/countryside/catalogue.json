    "ambient": [
      "it smells like rain and cut grass",
      "nothing is trying to sell me anything. suspicious.",
      "I could get used to this. that is the danger.",
      "every tree here is older than every building back home",
      "the birds do not care who is watching",
      "you can hear the wind think out here",
      "somebody should fix that mill"
    ],
    "weather": {
      "rain": [
