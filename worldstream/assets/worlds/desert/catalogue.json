  "lines": {
    "ambient": [
      "the sand remembers nothing",
      "hot. then cold. then hot.",
      "I miss the noise, a little",
      "somewhere out there is a road",
      "nothing for miles. perfect.",
      "the stars are louder here",
      "if you listen, the dunes hum",
      "water would be nice. so would shade.",
      "the city feels like a dream from here",
      "every rock out here has a name. I forget them.",
      "the windmill turns for nobody",
      "out here a rug counts as furniture"
    ],
    "weather": {
      "clear": [
        "not a cloud. not one.",
        "clear again. shocking."
      ],
      "storm": [
        "sandstorm. cover your eyes",
        "here comes the sand"
      ],
      "fog": [
        "dust on the wind",
        "hazy. can't see the mesas."
      ],
      "rain": [
        "rain? here? make a wish",
        "the desert is drinking"
      ]
    },
    "added": [
      "{user} dragged a {thing} out here",
      "a {thing}, in the middle of nowhere. {user}'s doing",
      "{user} thinks the desert needed a {thing}",
      "okay. a {thing}. thanks {user}"
    ],
    "addedText": [
      "{user} carved \"{text}\" into the sign",
      "a sign now reads \"{text}\". {user}.",
      "\"{text}\", says a sign, says {user}"
    ],
    "removed": [
      "the {thing} sinks into the sand",
      "{thing}, buried",
      "and the {thing} is gone. the desert wins."
    ]
  },
